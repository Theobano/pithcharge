// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                  @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                     String
  email                    String
  emailVerified            Boolean                 @default(false)
  image                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  role                     String?
  banned                   Boolean?                @default(false)
  banReason                String?
  banExpires               DateTime?
  isAnonymous              Boolean?                @default(false)
  phoneNumber              String?
  phoneNumberVerified      Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  members                  Member[]
  invitations              Invitation[]
  tokens                   UserOcppToken[]
  chargingSessions         ChargingSession[]
  wallets                  Wallet[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  pushSubscriptions        PushSubscription[]
  auditEvents              AuditLog[]              @relation("AuditActor")

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id                   String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name         String?
  publicKey    String
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Organization {
  id               String            @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name             String
  slug             String
  logo             String?
  createdAt        DateTime
  metadata         String?
  members          Member[]
  invitations      Invitation[]
  billingPolicy    BillingPolicy?
  rateRules        RateRule[]
  wallets          Wallet[]
  chargingSessions ChargingSession[]
  notifications    Notification[]
  invoices         MonthlyInvoice[]
  ledgerAccounts   LedgerAccount[]
  auditEvents      AuditLog[]        @relation("AuditOrganization")

  @@unique([slug])
  @@map("organization")
}

model Member {
  id                   String       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  organizationId       String       @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String       @db.Uuid
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 String       @default("member")
  billingWalletId      String?
  billingWallet        Wallet?      @relation("MemberBillingWallet", fields: [billingWalletId], references: [id], onDelete: SetNull)
  allowNegativeBalance Boolean      @default(false)
  negativeBalanceLimit Decimal?     @db.Decimal(12, 2)
  createdAt            DateTime

  @@index([organizationId])
  @@index([userId])
  @@index([billingWalletId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String       @db.Uuid
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// OCPP 2.0.1 IdTokenEnumType
enum TokenType {
  Central
  eMAID
  ISO14443
  ISO15693
  KeyCode
  Local
  MacAddress
  NoAuthorization
}

enum TokenStatus {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
  DELETED
}

model UserOcppToken {
  id     String @id @default(uuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  idToken           String  @unique // Hardware string (e.g. RFID UID or "APP_USR_101")
  printedCardNumber String? // Serial number printed on plastic card
  nickname          String?

  tokenType  TokenType   @default(ISO14443)
  status     TokenStatus @default(PENDING_ACTIVATION)
  isDefault  Boolean     @default(false)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChargingSession[]

  @@index([userId])
  @@index([idToken])
}

enum SessionStatus {
  PENDING // RemoteStart requested, waiting for charger plug-in
  ACTIVE // Vehicle connected, current flowing
  COMPLETED // Session ended normally
  FAILED // Cable error, emergency stop, or authorization failure
}

model ChargingSession {
  id String @id @default(uuid())

  // Ownership
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId String?
  token   UserOcppToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  ocppTransactionId String? @unique
  idTokenValue      String

  // Hardware Metadata
  stationId   String
  evseId      Int    @default(1)
  connectorId Int    @default(1)

  // Status & Timing
  status    SessionStatus @default(PENDING)
  startTime DateTime      @default(now())
  endTime   DateTime?

  // Energy & Billing
  startMeterKwh Float @default(0.0)
  lastMeterKwh  Float @default(0.0)
  totalKwh      Float @default(0.0)

  totalCost            Decimal         @default(0.00) @db.Decimal(12, 2)
  currency             String          @default("NGN")
  ratePerKwh           Decimal?        @db.Decimal(12, 4)
  ratePerMinute        Decimal?        @db.Decimal(12, 4)
  pricingSnapshot      Json?
  sessionFee           Decimal?        @db.Decimal(12, 2)
  idleFeePerMinute     Decimal?        @db.Decimal(12, 4)
  allowNegativeBalance Boolean?        @default(false)
  negativeBalanceLimit Decimal?        @db.Decimal(12, 2)
  organizationId       String?         @db.Uuid
  organization         Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  walletId             String?
  wallet               Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)
  paymentHoldId        String?         @unique
  paymentHold          PaymentHold?    @relation(fields: [paymentHoldId], references: [id], onDelete: SetNull)
  billedAt             DateTime?
  // Portion of totalCost the wallet could not cover; collected through the next invoice.
  receivableAmount     Decimal         @default(0) @db.Decimal(12, 2)
  invoiceId            String?
  invoice              MonthlyInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([stationId])
  @@index([ocppTransactionId])
  @@index([organizationId, status])
  @@index([walletId, status])
  @@index([invoiceId])
}

enum BillingMode {
  PREPAID
  POSTPAID
}

enum BillingCycleUnit {
  DAY
  WEEK
  MONTH
}

enum WalletSharingMode {
  SHARED
  INDIVIDUAL
  MIXED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountType {
  WALLET_LIABILITY
  ACCOUNTS_RECEIVABLE
  CHARGING_REVENUE
  PAYMENT_CLEARING
  REFUNDS_PAYABLE
  PLATFORM_EQUITY
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum PaymentHoldStatus {
  PENDING
  AUTHORIZED
  RELEASE_PENDING
  RELEASED
  CAPTURE_PENDING
  CAPTURED
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ChargingRateScope {
  PLATFORM
  HUB
  STATION
}

enum ChargingRateSource {
  MANUAL
  CSMS
}

// Public-network pricing. Resolution order: STATION, then HUB, then PLATFORM, then the CSMS tariff.
// scopeId is '' for PLATFORM, the hub id for HUB and the station id for STATION.
model ChargingRate {
  id               String             @id @default(uuid())
  scope            ChargingRateScope
  scopeId          String             @default("")
  // CSMS = use the CSMS tariff as-is; MANUAL = use the values below (blank values fall back to the CSMS tariff).
  source           ChargingRateSource @default(MANUAL)
  currency         String             @default("NGN")
  ratePerKwh       Decimal?           @db.Decimal(12, 4)
  ratePerMinute    Decimal?           @db.Decimal(12, 4)
  sessionFee       Decimal?           @db.Decimal(12, 2)
  idleFeePerMinute Decimal?           @db.Decimal(12, 4)
  updatedBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([scope, scopeId])
}

model RateRule {
  id               String       @id @default(uuid())
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  priority         Int          @default(0)
  active           Boolean      @default(true)
  // 0 = Sunday ... 6 = Saturday; empty means every day.
  daysOfWeek       Int[]
  // Local wall-clock window ("HH:MM") in the policy timezone; both null means all day. start > end wraps past midnight.
  startTime        String?
  endTime          String?
  // Empty means all stations.
  stationIds       String[]
  validFrom        DateTime?
  validUntil       DateTime?
  ratePerKwh       Decimal      @db.Decimal(12, 4)
  ratePerMinute    Decimal?     @db.Decimal(12, 4)
  sessionFee       Decimal?     @db.Decimal(12, 2)
  idleFeePerMinute Decimal?     @db.Decimal(12, 4)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, active])
}

model BillingPolicy {
  id                         String            @id @default(uuid())
  organizationId             String            @unique @db.Uuid
  organization               Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingMode                BillingMode       @default(PREPAID)
  walletSharingMode          WalletSharingMode @default(SHARED)
  currency                   String            @default("NGN")
  ratePerKwh                 Decimal?          @db.Decimal(12, 4)
  ratePerMinute              Decimal?          @db.Decimal(12, 4)
  timezone                   String            @default("Africa/Lagos")
  sessionFee                 Decimal?          @db.Decimal(12, 2)
  idleFeePerMinute           Decimal           @default(0) @db.Decimal(12, 4)
  sessionAuthorizationAmount Decimal           @default(25) @db.Decimal(12, 2)
  monthlyMinimumSpend        Decimal           @default(0) @db.Decimal(12, 2)
  paymentTermDays            Int               @default(30)
  billingCycleUnit           BillingCycleUnit  @default(MONTH)
  billingCycleInterval       Int               @default(1)
  billingCycleAnchor         DateTime?
  autoInvoice                Boolean           @default(true)
  invoiceCursor              DateTime?
  allowNegativeBalance       Boolean           @default(false)
  negativeBalanceLimit       Decimal           @default(0) @db.Decimal(12, 2)
  lowCreditThreshold         Decimal?          @db.Decimal(12, 2)
  updatedBy                  String?           @db.Uuid
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([billingMode, walletSharingMode])
}

model Wallet {
  id               String               @id @default(uuid())
  organizationId   String               @db.Uuid
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String?              @db.Uuid
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String?
  currency         String               @default("NGN")
  scopeKey         String               @default("shared")
  balance          Decimal              @default(0) @db.Decimal(18, 2)
  reservedBalance  Decimal              @default(0) @db.Decimal(18, 2)
  status           WalletStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  chargingSessions ChargingSession[]
  ledgerAccounts   LedgerAccount[]
  paymentHolds     PaymentHold[]
  payments         PaymentTransaction[]
  members          Member[]             @relation("MemberBillingWallet")

  @@unique([organizationId, currency, scopeKey])
  @@index([organizationId, status])
  @@index([userId, status])
}

model LedgerAccount {
  id             String            @id @default(uuid())
  organizationId String?           @db.Uuid
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  walletId       String?           @unique
  wallet         Wallet?           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  code           String
  type           LedgerAccountType
  currency       String
  createdAt      DateTime          @default(now())
  entries        LedgerEntry[]

  @@unique([organizationId, code, currency])
  @@index([type, currency])
}

model LedgerTransaction {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  organizationId String?       @db.Uuid
  referenceType  String
  referenceId    String
  description    String
  currency       String
  postedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@index([organizationId, postedAt])
  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id            String               @default(uuid())
  transactionId String
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(18, 2)
  currency      String
  createdAt     DateTime             @default(now())

  // Partitioned monthly by createdAt (see migration partition_audit_ledger); the key must include it.
  @@id([id, createdAt])
  @@index([accountId, createdAt])
  @@index([transactionId])
}

model PaymentHold {
  id                String            @id @default(uuid())
  provider          String
  providerReference String            @unique
  idempotencyKey    String            @unique
  userId            String            @db.Uuid
  organizationId    String            @db.Uuid
  walletId          String?
  wallet            Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  stationId         String
  evseId            Int
  connectorId       Int?
  amount            Decimal           @db.Decimal(18, 2)
  capturedAmount    Decimal?          @db.Decimal(18, 2)
  currency          String
  status            PaymentHoldStatus @default(PENDING)
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  chargingSession   ChargingSession?

  @@index([userId, status])
  @@index([organizationId, status])
}

model PaymentTransaction {
  id                String            @id @default(uuid())
  idempotencyKey    String            @unique
  provider          String
  providerReference String?           @unique
  userId            String            @db.Uuid
  organizationId    String            @db.Uuid
  walletId          String
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amount            Decimal           @db.Decimal(18, 2)
  currency          String
  status            PaymentHoldStatus @default(PENDING)
  failureMessage    String?
  chargeAttemptedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([userId, createdAt])
}

model MonthlyInvoice {
  id               String            @id @default(uuid())
  organizationId   String            @db.Uuid
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idempotencyKey   String            @unique
  periodStart      DateTime
  periodEnd        DateTime
  actualSpend      Decimal           @db.Decimal(18, 2)
  minimumSpend     Decimal           @db.Decimal(18, 2)
  usageCharges     Decimal           @default(0) @db.Decimal(18, 2)
  shortfallCharges Decimal           @default(0) @db.Decimal(18, 2)
  sessionCount     Int               @default(0)
  trigger          String            @default("SCHEDULED")
  issuedBy         String?           @db.Uuid
  sessions         ChargingSession[]
  amountDue        Decimal           @db.Decimal(18, 2)
  currency         String
  status           InvoiceStatus     @default(ISSUED)
  issuedAt         DateTime          @default(now())
  dueAt            DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, periodStart])
  @@index([organizationId, status, periodStart])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionUpdates   Boolean  @default(true)
  paymentUpdates   Boolean  @default(true)
  chargerUpdates   Boolean  @default(false)
  lowCreditUpdates Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  pushEnabled      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id             String                 @id @default(uuid())
  userId         String?                @db.Uuid
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?                @db.Uuid
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventKey       String
  title          String
  body           String
  data           Json?
  readAt         DateTime?
  createdAt      DateTime               @default(now())
  deliveries     NotificationDelivery[]

  @@unique([eventKey, userId])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model NotificationDelivery {
  id             String                     @id @default(uuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime                   @default(now())

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model IntegrationOutbox {
  id             String       @id @default(uuid())
  eventType      String
  aggregateId    String
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
}

model AuditLog {
  id             String        @default(uuid())
  actorId        String?       @db.Uuid
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?       @db.Uuid
  organization   Organization? @relation("AuditOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  // Partitioned monthly by createdAt (see migration partition_audit_ledger); the key must include it.
  @@id([id, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}
