# Used only by `docker compose` (copy to .env). Per-app variables for local development live in:
#   apps/bff/.env.example      API: database, auth, Google sign-in, CSMS, payments, notifications
#   apps/web/.env.example      Web: NEXT_PUBLIC_* URLs
#   apps/worker/.env.example   Background worker: database, retention, notifications
#   packages/db/.env.example   Prisma CLI / @pithcharge/db

# REQUIRED: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=pithcharge

# Browser-facing URLs (the web image bakes the BFF URL in at build time).
PUBLIC_BFF_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3100

# `production` (default) rejects mock providers. For a local trial set NODE_ENV=development,
# CMS_PROVIDER=mock and PAYMENT_PROVIDERS=mock.
NODE_ENV=production
CMS_PROVIDER=citrineos
CITRINEOS_URL=
CITRINEOS_GRAPHQL_URL=
CITRINEOS_API_KEY=
CITRINEOS_HASURA_ADMIN_SECRET=
CITRINEOS_TENANT_ID=
CITRINEOS_WEBHOOK_SECRET=

PAYMENT_PROVIDERS=paystack
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Outgoing email (invitations, password reset, notifications). SMTP works with any provider
# (Resend, SendGrid, Mailgun, SES, Postmark, Gmail app password, your own server).
# Leave SMTP_HOST empty to disable email; the legacy relay below is used if set instead.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Pithcharge
EMAIL_REPLY_TO=
# Require new users to verify their email before signing in (only applies when email is configured).
EMAIL_REQUIRE_VERIFICATION=false
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
