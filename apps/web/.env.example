# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are baked in at build time.

# Branding (read at runtime; restart the web server after changing). Logo/favicon accept an
# absolute URL or a path under apps/web/public (e.g. /branding/logo.svg). Empty = built-in defaults.
APP_NAME=Pithcharge
# APP_LOGO_URL: wide logo shown alone (no name) when expanded.
# APP_LOGO_SMALL_URL: square mark for the collapsed sidebar; with no big logo it is shown beside APP_NAME.
APP_LOGO_URL=
APP_LOGO_SMALL_URL=
APP_FAVICON_URL=

# Origin of the BFF (no trailing slash, no /api/v1).
NEXT_PUBLIC_BFF_URL=http://localhost:4000
# Full API base used by the admin console.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public Web Push key; set only when enabling browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
