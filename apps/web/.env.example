# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are baked in at build time.

# Origin of the BFF (no trailing slash, no /api/v1).
NEXT_PUBLIC_BFF_URL=http://localhost:4000
# Full API base used by the admin console.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public Web Push key; set only when enabling browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
