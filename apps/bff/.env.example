NODE_ENV=development
LOG_LEVEL=info
# Optional: separate (direct, non-pooled) connection for the pg-boss job queue.
# JOBS_DATABASE_URL=
# Instance name shown in pg-boss (default: api).
# JOBS_INSTANCE_NAME=api
DATABASE_URL=postgresql://user:password@localhost:5432/ev_charger

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3100
APP_NAME=Pithcharge
# Public URL of the web app (links in emails and invitations).
WEB_APP_URL=http://localhost:3100

# Google sign-in is enabled when both are set. Redirect URI: {BETTER_AUTH_URL}/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development can use mock. Production must use citrineos.
CMS_PROVIDER=mock
CITRINEOS_URL=
CITRINEOS_GRAPHQL_URL=
CITRINEOS_API_KEY=
CITRINEOS_HASURA_ADMIN_SECRET=
CITRINEOS_TENANT_ID=
CITRINEOS_WEBHOOK_SECRET=

# Comma-separated list of enabled wallet-funding providers: mock, paystack, flutterwave, remita.
# The first is the default. `mock` is development-only and rejected in production.
# Point provider webhooks at {BFF}/api/v1/billing/webhooks/<provider> (optional; the return page also verifies).
PAYMENT_PROVIDERS=mock
# Required only for providers listed above.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
# Defaults to Remita demo; use https://login.remita.net for live.
REMITA_BASE_URL=

# Outgoing email (invitations, password reset, notifications). SMTP works with any provider
# (Resend, SendGrid, Mailgun, SES, Postmark, Gmail app password, your own server).
# Leave SMTP_HOST empty to disable email; the legacy relay below is used if set instead.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Pithcharge
EMAIL_REPLY_TO=
# Require new users to verify their email before signing in (only applies when email is configured).
EMAIL_REQUIRE_VERIFICATION=false
# Optional notification delivery relays; relay endpoints accept signed JSON POST requests.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Only for `pnpm create-admin`.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
