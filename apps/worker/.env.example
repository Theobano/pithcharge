# Copy to apps/worker/.env (or inject as real environment variables).

# REQUIRED: same database as the API. Queue tables live in the `pgboss` schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev-charger-ui
# Optional: separate (direct, non-pooled) connection for the queue.
# JOBS_DATABASE_URL=

WORKER_NAME=worker
WORKER_DB_POOL=5
# Parallel organization invoice jobs per replica.
INVOICE_CONCURRENCY=3

# Audit-log retention. Unset = keep forever. ARCHIVE_DIR is required when retention is enabled.
# AUDIT_RETENTION_DAYS=365
# ARCHIVE_DIR=/var/lib/ev-charger/archive

# Outgoing email (invitations, password reset, notifications). SMTP works with any provider
# (Resend, SendGrid, Mailgun, SES, Postmark, Gmail app password, your own server).
# Leave SMTP_HOST empty to disable email; the legacy relay below is used if set instead.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Pithcharge
EMAIL_REPLY_TO=
# Require new users to verify their email before signing in (only applies when email is configured).
EMAIL_REQUIRE_VERIFICATION=false
# Read by @pithcharge/notifications when the worker creates invoice notifications: a channel is only queued
# for delivery if its URL and secret are set here. Delivery itself is performed by the API process,
# so use the same values as the API. Optional: without them only the in-app notification is created.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
